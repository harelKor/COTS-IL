# Copy of the variables the app needs. For local development run
# `npm run env:local` instead, which fills these from the local Supabase stack.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Password shared by the seeded local users (scripts/seed.ts)
SEED_PASSWORD=
